	partition DimDate = calculated
		mode: import
		source =
				ADDCOLUMNS (
				    CALENDAR ( DATE ( 2025, 1, 1 ), DATE ( 2025, 12, 30 ) ),
				    "Year",       YEAR ( [Date] ),
				    "Month No",   MONTH ( [Date] ),
				    "Month Name", FORMAT ( [Date], "MMM" ),
				    "Quarter",    "Q" & FORMAT ( [Date], "Q" )
				)

	annotation PBI_Id = 53db62ac2eb4438cb6ad5b4170720eff

